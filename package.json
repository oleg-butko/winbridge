{
  "name": "winbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "dev:ui": "vite --host 127.0.0.1",
    "build:ui": "vite build",
    "typecheck": "tsc -p ui/tsconfig.json --noEmit",
    "check:scaffold": "node scripts/check-scaffold.mjs",
    "check:rust": "cargo check --workspace --locked",
    "test:rust": "cargo test --workspace --locked",
    "format:check": "cargo fmt --all -- --check"
  },
  "dependencies": {
    "@mantine/core": "^8.3.16",
    "@mantine/hooks": "^8.3.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
