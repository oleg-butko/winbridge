{
  "schemaVersion": 1,
  "instanceId": "local-development",
  "nodeId": "windows-host",
  "worker": {
    "controllerUrl": "ws://192.168.44.203:1143",
    "keepRunningOnUiExit": true
  },
  "delivery": {
    "adapter": "shared-folder",
    "root": "K:\\VMs\\shared",
    "namespace": "WinBridge"
  },
  "stateDirectory": "K:\\WinBridge\\state",
  "maxOutputBytesPerTask": 16777216,
  "outputRetention": { "automatic": false, "olderThanDays": 30 },
  "projects": [
    {
      "id": "netwatch",
      "workspaceRoot": "K:\\WinBridge\\workspaces\\netwatch",
      "allowDirectCommands": true,
      "maxConcurrentMutations": 1,
      "recipes": [
        {
          "id": "build-portable",
          "executable": "node.exe",
          "arguments": ["scripts/build-portable.mjs"],
          "workingDirectory": ".",
          "timeoutMs": 1800000
        }
      ]
    }
  ]
}
